# Supabase Configuration
# Copy this file to .env.local and fill in your actual project credentials.

# Supabase Dashboard > Settings > API > Project URL
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Dashboard > Settings > API > Project API keys > anon/public
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key

# Optional Google Analytics measurement ID. Analytics stays disabled when empty.
REACT_APP_GA_MEASUREMENT_ID=

# IMPORTANT: Never expose a Supabase service-role key in a React environment variable.
# Server-only secrets must remain on a trusted server.
